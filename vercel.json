{
  "buildCommand": "npm run build --workspace=frontend",
  "outputDirectory": "frontend/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://twofold-mwaj.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
